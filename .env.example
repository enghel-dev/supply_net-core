# Copia este archivo a ".env" y ajusta valores si hace falta.
# ".env" NO se sube a git (ver .gitignore).

# ---------- Postgres ----------
POSTGRES_USER=supplynet
POSTGRES_PASSWORD=supplynet_dev_password
POSTGRES_DB=supplynet
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PORT=6379

# ---------- Backend ----------
BACKEND_PORT=3000
# DATABASE_URL y REDIS_URL se arman solos en docker-compose.yml a partir
# de las variables de arriba, no hace falta repetirlas aquí.
# Cambiar este valor en tu .env real antes de usar el backend en serio —
# firma los JWT de sesión (RF-01).
JWT_SECRET_KEY=cambia-esto-en-tu-env-local

# ---------- Frontend (usar cuando el servicio esté activo) ----------
FRONTEND_PORT=5173
